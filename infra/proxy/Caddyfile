# Routes by path prefix without rewriting API paths (spec 01, section 3.6; ADR-021).
# SITE_ADDRESS is ":80" on one machine and the domain on a server, where Caddy obtains the TLS certificate itself.
{
	# The configuration is baked into the image; a change means a new container, not a live reload.
	admin off
	order rate_limit before basic_auth
}

# Hashed bundles never change; every other file revalidates. Argument: app base path.
(cache_rules) {
	@hashed path {args[0]}assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidated not path {args[0]}assets/*
	header @revalidated Cache-Control "no-cache"
}

# Client-side routing: real files are served as they are, a missing file with an extension is a real 404,
# and every other path gets the entry page of the app. Arguments: file root, app base path.
(spa) {
	root * {args[0]}
	import cache_rules {args[1]}
	@file path_regexp static_file \.[A-Za-z0-9]+$
	handle @file {
		file_server
	}
	handle {
		rewrite * {args[1]}index.html
		file_server
	}
}

# Internal health listener; the port is not published.
http://127.0.0.1:2020 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format filter {
			# Sign-in codes and presigned signatures travel in the query string; keep them out of the logs.
			fields {
				request>uri query {
					delete code
					delete state
					delete session_code
					delete id_token_hint
					delete X-Amz-Signature
					delete X-Amz-Credential
				}
			}
			wrap json
		}
	}

	# Per-client limits on credential and form endpoints (ADR-007). Reading the wiki is not limited here, and neither is
	# the token endpoint: public clients have no password grant, and silent sign-in calls it on every page load.
	rate_limit {
		zone sign_in {
			match {
				method POST
				path /api/wiki/*/auth/login /api/wiki/*/auth/google
				path /idp/realms/*/login-actions/*
			}
			key {remote_host}
			events 60
			window 1m
		}
		zone contact {
			match {
				method POST
				path /api/wiki/*/media/contact-requests
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	handle /api/wiki/* {
		reverse_proxy wiki-service:8080
	}

	handle /api/community/* {
		reverse_proxy community-service:8082
	}

	handle /api/* {
		respond 404
	}

	# Public realm endpoints only. The Keycloak admin console and the master realm stay off this listener.
	handle /idp/realms/master/* {
		respond 404
	}

	@identity path /idp/realms/* /idp/resources/*
	handle @identity {
		reverse_proxy keycloak:8080
	}

	handle /idp/* {
		respond 404
	}

	# Validated, immutable bytes only: GET/HEAD on the exact versioned URL, mapped to assets/ of the bucket.
	@media {
		method GET HEAD
		path_regexp media ^/media/([a-f0-9-]{36})/([a-f0-9-]{36}\.(?:png|jpg|webp))$
	}
	handle @media {
		rewrite * /buckets/{$STORAGE_BUCKET:wiki-media}/assets/{re.media.1}/{re.media.2}
		reverse_proxy seaweedfs:8888 {
			header_down -Server
			header_down -X-Amz-Request-Id
			header_down -Access-Control-Expose-Headers
		}
	}

	handle /media/* {
		respond 404
	}

	# Presigned uploads and reads only: the bucket stays closed without a valid signature from wiki-service.
	# The Host header is part of that signature, and reverse_proxy forwards it unchanged.
	@presigned {
		method GET HEAD PUT
		path /{$STORAGE_BUCKET:wiki-media}/*
		query X-Amz-Signature=*
	}
	handle @presigned {
		reverse_proxy seaweedfs:8333
	}

	handle /{$STORAGE_BUCKET:wiki-media}/* {
		respond 403
	}

	# Dev-server middleware of the admin app; a static build has none, and the app handles the 404.
	handle /__* {
		respond 404
	}

	redir /stream /stream/ 308
	redir /admin /admin/ 308

	handle /stream/* {
		import spa /srv /stream/
	}

	handle /admin/* {
		import spa /srv /admin/
	}

	# The Wiki looks for a page of its own first, because a rewrite would give every address the title and canonical
	# of the home page. The service wiki-prerender keeps this folder; 200.html is for addresses it has no page for.
	handle {
		root * /srv/wiki
		import cache_rules /
		@wiki_file path_regexp wiki_file \.[A-Za-z0-9]+$
		handle @wiki_file {
			file_server
		}
		handle {
			try_files {path} {path}/index.html /200.html /index.html
			file_server
		}
	}
}
