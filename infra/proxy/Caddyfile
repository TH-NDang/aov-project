# Routes by path prefix without rewriting API paths (spec 01, section 3.6; ADR-021).
# SITE_ADDRESS is ":80" on one machine and the domain on a server, where Caddy obtains the TLS certificate itself.
# Media bytes never pass here: public images come from the R2 bucket's own domain, and browsers upload and read
# source files straight from R2 with presigned URLs.
{
	# Compose mounts this folder, and deploy.sh applies a new version with `caddy reload`, which needs the admin API.
	# It listens inside the container only; no port is published and other containers cannot reach it.
	admin localhost:2019
	order rate_limit before basic_auth
	# With a CDN in front (Cloudflare proxy), TRUSTED_PROXIES lists its address ranges, so that {client_ip} is the
	# visitor and not the CDN: rate limits, the services' sign-in throttles and Keycloak's brute-force detection all
	# read it. Empty trusts nobody: {client_ip} is then the address that connected.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# A backend service found by its Compose name. During an update two containers answer to that name, the old one and
# the new one; a request that cannot reach one of them (it is shutting down) is tried on the other. Argument: name, port.
(backend) {
	reverse_proxy {
		# One address, the visitor's: the services read it for their sign-in throttles.
		header_up X-Forwarded-For {client_ip}
		dynamic a {args[0]} {args[1]} {
			refresh 1s
		}
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s
	}
}

# Hashed bundles never change; every other file revalidates. Argument: app base path.
(cache_rules) {
	@hashed path {args[0]}assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidated not path {args[0]}assets/*
	header @revalidated Cache-Control "no-cache"
}

# Client-side routing: real files are served as they are, a missing file with an extension is a real 404,
# and every other path gets the entry page of the app. Arguments: file root, app base path.
(spa) {
	root * {args[0]}
	import cache_rules {args[1]}
	@file path_regexp static_file \.[A-Za-z0-9]+$
	handle @file {
		file_server
	}
	handle {
		rewrite * {args[1]}index.html
		file_server
	}
}

# Internal health listener; the port is not published.
http://127.0.0.1:2020 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
	}

	# The Wiki, Stream and Admin share this origin with content people post, so scripts may only come from here
	# (and the YouTube player API of Admin's VOD player). Pictures and links in posts can name any https host. Keycloak
	# under /idp sends a policy of its own.
	@apps not path /idp/*
	header @apps {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.twitch.tv https://clips.twitch.tv https://www.facebook.com https://www.tiktok.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format filter {
			# Sign-in codes travel in the query string; keep them out of the logs.
			fields {
				request>uri query {
					delete code
					delete state
					delete session_code
					delete id_token_hint
				}
			}
			wrap json
		}
	}

	# Per-client limits on credential and form endpoints (ADR-007). Reading the wiki is not limited here, and neither is
	# the token endpoint: public clients have no password grant, and silent sign-in calls it on every page load.
	rate_limit {
		zone sign_in {
			match {
				method POST
				path /api/wiki/*/auth/login /api/wiki/*/auth/google
				path /idp/realms/*/login-actions/*
			}
			key {client_ip}
			events 60
			window 1m
		}
		zone contact {
			match {
				method POST
				path /api/wiki/*/media/contact-requests
			}
			key {client_ip}
			events 10
			window 1m
		}
		# Signed-in writes: posts, comments, reports, follows, lineups, profile and avatar uploads.
		zone member_writes {
			match {
				method POST PUT DELETE
				path_regexp ^/api/(community/[^/]+/me|wiki/[^/]+/users)/
			}
			key {client_ip}
			events 60
			window 1m
		}
	}

	handle /api/wiki/* {
		import backend wiki-service 8080
	}

	handle /api/community/* {
		import backend community-service 8082
	}

	handle /api/* {
		respond 404
	}

	# Public realm endpoints only. The Keycloak admin console and the master realm stay off this listener.
	handle /idp/realms/master/* {
		respond 404
	}

	@identity path /idp/realms/* /idp/resources/*
	handle @identity {
		reverse_proxy keycloak:8080 {
			# Keycloak logs and limits by this address (KC_PROXY_HEADERS=xforwarded).
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /idp/* {
		respond 404
	}

	# Dev-server middleware of the admin app; a static build has none, and the app handles the 404.
	handle /__* {
		respond 404
	}

	redir /stream /stream/ 308
	redir /admin /admin/ 308

	# The service web-publish keeps /srv/apps/stream and /srv/apps/admin.
	handle /stream/* {
		import spa /srv/apps /stream/
	}

	handle /admin/* {
		import spa /srv/apps /admin/
	}

	# The Wiki looks for a page of its own first, because a rewrite would give every address the title and canonical
	# of the home page. The service wiki-prerender keeps this folder; 200.html is for addresses it has no page for.
	handle {
		root * /srv/wiki
		import cache_rules /
		@wiki_file path_regexp wiki_file \.[A-Za-z0-9]+$
		handle @wiki_file {
			file_server
		}
		handle {
			try_files {path} {path}/index.html /200.html /index.html
			file_server
		}
	}
}
