# Copy to .env (git-ignored) and fill in the object storage section first: values in angle brackets are samples, and
# preflight lists each one still left. The other values only suit a run on this machine: the system refuses to start
# with them on a public origin. Use letters and digits in secrets, since Compose treats $ specially.

# ---- Address ----
# The origin browsers use, without a trailing slash. Compiled into the frontend: rebuild after changing it.
PUBLIC_ORIGIN=http://localhost:18080
# What Caddy listens on: ":80" on this machine, the bare domain on a server (Caddy then obtains TLS certificates).
SITE_ADDRESS=:80
# 127.0.0.1 here, 0.0.0.0 on a server (with HTTP_PORT=80 and HTTPS_PORT=443).
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
# Keycloak admin console, always on 127.0.0.1 only.
KEYCLOAK_ADMIN_PORT=18081
# Must be true with HTTPS. False is only for a plain http:// loopback origin.
AUTH_SECURE_COOKIES=false
# "cloudflare" makes the Wiki ask for Media pictures at the size it draws them, through Cloudflare image
# transformations on the picture host. Turn transformations on for that zone first; empty serves full-size pictures.
# Compiled into the frontend: rebuild after changing it.
IMAGE_RESIZE=

# ---- Bundled test accounts ----
# Remove test-identity on a real server; the accounts below then do not exist.
COMPOSE_PROFILES=test-identity
# Sign in as admin, editor or publisher with this password.
TEST_USER_PASSWORD=change-me-test-user

# ---- PostgreSQL: one login per service ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
WIKI_DB_PASSWORD=change-me-wiki-db
COMMUNITY_DB_PASSWORD=change-me-community-db
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
# Automatic pre-start database dumps to keep.
BACKUP_KEEP=10

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Server-only secrets of the confidential clients. Read when the realm is first imported.
ADMIN_AUTH_CLIENT_SECRET=change-me-admin-auth-client
WIKI_IMPORTER_CLIENT_SECRET=change-me-wiki-importer-client
# wiki-service account security: service account and token exchange (ADR-028).
WIKI_SERVICE_CLIENT_SECRET=change-me-wiki-service-client
GOOGLE_LOGIN_ENABLED=false

# ---- Object storage: Cloudflare R2 (ADR-014, ADR-030) ----
# The buckets and image domain of the live site, prepared on Cloudflare, never by this stack: see "Cloudflare R2" in
# README.md. Only one database may use them, the one moved over from dev. A second database (dev after launch, a trial
# run on an empty database) needs buckets of its own.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Address written into presigned URLs; browsers upload and read source files straight from R2. Empty uses
# STORAGE_ENDPOINT, which is right for R2.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PATH_STYLE=true
# An R2 API token of this server alone, with Object Read & Write on the three buckets below only. Never reuse the token
# of a development machine.
STORAGE_ACCESS_KEY=<r2-access-key-id>
STORAGE_SECRET_KEY=<r2-secret-access-key>
# Private: uploads waiting for validation (incoming/) and import files (imports/).
STORAGE_BUCKET=aov-media-private
# Public: validated images (assets/), served by the custom domain in MEDIA_PUBLIC_BASE_URL.
STORAGE_ASSETS_BUCKET=aov-media-assets
# Private: evidence captures and import data (sources/). No custom domain, no r2.dev URL.
STORAGE_SOURCES_BUCKET=aov-source-private
# Custom domain of the assets bucket; the /assets suffix is required.
MEDIA_PUBLIC_BASE_URL=https://img.athahub.com/assets
# Deleting an image also purges its URL from the Cloudflare cache: the zone ID of athahub.com (not the account ID) and
# a token with only Zone / Cache Purge on that zone. With false the system starts, but refuses to delete images.
MEDIA_CLOUDFLARE_PURGE_ENABLED=true
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
# With IMAGE_RESIZE=cloudflare: widths made right after an upload, so the first reader of a new picture does not wait for
# Cloudflare to resize it, for example 128,256,768,1536 (the Wiki's widths are in sized-image.ts). Empty makes none.
MEDIA_WARM_WIDTHS=
# Optional real R2 usage figures in Admin: a token with only Account Analytics: Read (ADR-030 section 9).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=

# ---- Mail (ADR-028; ADR-021, addendum of 19/11/2026 on alerts) ----
# One SMTP relay for the codes that confirm a password change (wiki-service), Keycloak's password reset links
# (docker compose run --rm keycloak-mail) and the server's alerts (scripts/alert.sh). DigitalOcean blocks ports 465 and
# 587, so with Resend use MAIL_HOST=smtp.resend.com, MAIL_PORT=2587, MAIL_USERNAME=resend and the API key as password.
# Leave MAIL_HOST empty to send nothing: password changes stay off the settings page.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# An address on the site's own domain, verified with the provider.
MAIL_FROM=AOV <no-reply@example.com>
# Who gets the server's alerts: failed updates, prerender and backup runs, a site that stops answering.
ALERT_EMAIL=

# ---- Offsite copy of the database dumps (ADR-021, addendum of 19/11/2026 on alerts) ----
# A private R2 bucket of its own, on the account of STORAGE_ENDPOINT, with a lifecycle rule that expires old dumps, and
# a token with Object Read & Write on that bucket only. Empty keeps the dumps on this machine only.
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=

# ---- Others ----
REDIS_PASSWORD=change-me-redis
# Calls api.frankfurter.dev for daily exchange rates (ADR-020).
COMMUNITY_EXCHANGE_RATES_ENABLED=true
