{
  "name": "@aov/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p lint/tsconfig.json",
    "lint": "node --experimental-strip-types lint/source-rules.ts && eslint src",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "test:auth": "node --experimental-strip-types --test tests/public-auth.test.mjs tests/public-auth-restore.test.mjs",
    "test:time-zone": "node --experimental-strip-types --test tests/time-zone.test.mjs tests/date-format.test.mjs",
    "test:currency": "node --experimental-strip-types --test tests/currency.test.mjs",
    "test:items": "node --experimental-strip-types --test tests/item-description.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "recharts": "3.11.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.3.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@aov/typescript-config": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5"
  }
}
