{
  "name": "@aov/aov-stream",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p lint/tsconfig.json",
    "lint": "node --experimental-strip-types lint/source-rules.ts && eslint src",
    "test": "tsx --import ./tests/fixtures/test-loader.mjs --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "test:tournaments": "node --experimental-strip-types --test tests/tournament-model.test.ts tests/match-model.test.ts tests/competition-model.test.ts tests/match-schedule.test.ts",
    "test:account": "node --experimental-strip-types --test tests/account-profile.test.ts",
    "test:community": "node --experimental-strip-types --test tests/post-media-model.test.ts tests/time-zone-days.test.ts"
  },
  "dependencies": {
    "@aov/community-contracts": "workspace:*",
    "@aov/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@aov/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "vite": "^8.0.0"
  }
}
