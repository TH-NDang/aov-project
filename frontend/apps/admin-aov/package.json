{
  "name": "@aov/admin-aov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:users": "tsx --test tests/avatar-upload.test.ts tests/profile-preferences.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test:storage": "node --experimental-strip-types --test tests/storage.test.ts",
    "test:table": "node --experimental-strip-types --test tests/table.test.ts",
    "test:heroes": "node --experimental-strip-types --test tests/heroes.test.ts",
    "test:tabs": "tsx --tsconfig tests/tsconfig.json --test tests/page-tabs.test.tsx",
    "test:publishing": "tsx --tsconfig tests/tsconfig.json --test tests/publishing.test.ts tests/wiki-public.test.tsx"
  },
  "dependencies": {
    "@aov/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "9.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aov/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/table-core": "9.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "vite": "^8.0.0"
  }
}
