# Optional destination override; omit to use the current host on port 5174.
VITE_STREAM_URL=http://localhost:5174

# Public origin of this site, without a path. Canonical links, previews and the sitemap are built from it.
# Leave it empty anywhere but production: such a build asks search engines not to index it.
VITE_WIKI_URL=

VITE_AUTH_ISSUER=http://localhost:8081/realms/wikiaov
VITE_AUTH_CLIENT_ID=aov-wiki
