{
  "name": "aov-frontend",
  "private": true,
  "intent": {
    "skills": [
      "@tanstack/react-table",
      "@tanstack/table-core"
    ]
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:wiki": "pnpm --filter @aov/aov-wiki dev",
    "dev:stream": "pnpm --filter @aov/aov-stream dev",
    "dev:admin": "pnpm --filter @aov/admin-aov dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:hero-api": "openapi-typescript ../backend/wiki-service/src/main/resources/contracts/hero-authoring.openapi.json -o apps/admin-aov/src/features/publishing/generated/hero-api.d.ts && prettier --write apps/admin-aov/src/features/publishing/generated/hero-api.d.ts"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.5",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
