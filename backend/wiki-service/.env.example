# Local Compose credentials only; never reuse in production.
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki-local
MINIO_ROOT_USER=wiki-local
MINIO_ROOT_PASSWORD=wiki-local-storage
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
# App: enable local profile in IDE or Maven. Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=local
# Enable JWT later with a configured wiki-service audience and issuer.

