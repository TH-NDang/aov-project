# Local development only. Never reuse these sample credentials in production.
# Variables of wiki-service only. community-service reads its own file, backend/community-service/.env (see its
# .env.example); COMMUNITY_API_BASE_URL below is wiki-service's address of community-service.
# Docker Compose reads .env automatically. The local launcher exports it for Spring;
# direct Maven/IDE startup uses exported environment variables instead.

# Compose database. The launcher derives DB_URL/DB_USERNAME/DB_PASSWORD from these
# unless the corresponding DB_* variable is explicitly set.
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki-local
# DB_URL=jdbc:postgresql://localhost:5432/wiki
# DB_USERNAME=wiki
# DB_PASSWORD=wiki-local

# Application and local identity provider.
SPRING_PROFILES_ACTIVE=local
PORT=8080
JWT_ISSUER_URI=http://localhost:8081/realms/wikiaov
JWT_AUDIENCE=wiki-service
JWT_RESOURCE_CLIENT_ID=wiki-service
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
ADMIN_ORIGIN=http://localhost:5175
ADMIN_BASE_PATH=/
ADMIN_AUTH_CLIENT_ID=admin-aov-backend
# Set the same server-only client secret before importing the local Keycloak realm.
ADMIN_AUTH_CLIENT_SECRET=
GOOGLE_LOGIN_ENABLED=false
# Account security (ADR-028): server-only secret of the wiki-service Keycloak client (service account and token
# exchange). Set it before importing the realm, or apply it to an existing realm with scripts/sync-account-security.ps1.
WIKI_SERVICE_CLIENT_SECRET=

# Account email over SMTP. Locally: docker compose --profile mail up -d mailpit (UI http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=AOV <no-reply@aov.localhost>

# Object storage: Cloudflare R2 directly, also in development (ADR-030 section 14). Copy the real keys from your
# private .env.r2; never commit them. The buckets are created in the Cloudflare dashboard, not by the application.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=aov-media-private
STORAGE_ASSETS_BUCKET=aov-media-assets
STORAGE_SOURCES_BUCKET=aov-source-private
STORAGE_CREATE_BUCKET_IF_MISSING=false
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=REPLACE_LOCALLY
STORAGE_SECRET_KEY=REPLACE_LOCALLY
MEDIA_PUBLIC_BASE_URL=https://img.athahub.com/assets
# Optional R2 usage figures in Admin: a token with only "Account Analytics: Read" (ADR-030 section 9).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=

# Offline alternative: the bundled SeaweedFS (docker compose --profile local-storage up -d seaweedfs) with the Spring
# profiles "local,local-storage". Remove the STORAGE_* and MEDIA_PUBLIC_BASE_URL lines above, then keep S3 on loopback:
# STORAGE_BIND_ADDRESS=127.0.0.1

# Required for deleting images served by Cloudflare; use a Cache Purge token scoped to the image zone.
MEDIA_CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
COMMUNITY_API_BASE_URL=http://localhost:8082

# Optional read-model cache. Cache failures fall back to the database.
READ_MODEL_CACHE_ENABLED=true
READ_MODEL_CACHE_PREFIX=wiki:read-model:v1
READ_MODEL_CACHE_PUBLIC_TTL=2m
READ_MODEL_CACHE_ADMIN_TTL=30s
READ_MODEL_CACHE_RETRY_DELAY=5s
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# Defaults for new user profiles.
USER_DEFAULT_LOCALE=vi-VN
USER_DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh

