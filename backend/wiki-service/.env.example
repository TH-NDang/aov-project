# Local Compose credentials only; never reuse in production.
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki-local
# Object storage (SeaweedFS) keys are in seaweedfs/s3.json.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
# App: enable local profile in IDE or Maven. Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=local
# JWT issuer and object storage have local defaults in application-local.yml.

