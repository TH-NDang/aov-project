# Local development only. Never reuse these sample credentials in production.
# Docker Compose reads .env automatically. The local launcher exports it for Spring;
# direct Maven/IDE startup uses exported environment variables instead.

# Compose database. The launcher derives DB_URL/DB_USERNAME/DB_PASSWORD from these
# unless the corresponding DB_* variable is explicitly set.
POSTGRES_DB=wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki-local
# DB_URL=jdbc:postgresql://localhost:5432/wiki
# DB_USERNAME=wiki
# DB_PASSWORD=wiki-local

# Application and local identity provider.
SPRING_PROFILES_ACTIVE=local
PORT=8080
JWT_ISSUER_URI=http://localhost:8081/realms/wikiaov
JWT_AUDIENCE=wiki-service
JWT_RESOURCE_CLIENT_ID=wiki-service
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
ADMIN_ORIGIN=http://localhost:5175
ADMIN_BASE_PATH=/
ADMIN_AUTH_CLIENT_ID=admin-aov-backend
# Set the same server-only client secret before importing the local Keycloak realm.
ADMIN_AUTH_CLIENT_SECRET=
GOOGLE_LOGIN_ENABLED=false

# SeaweedFS: values match infra/local/seaweedfs/s3.json. Keep S3 on loopback by default.
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wiki-media
# Optional separate bucket for validated assets; empty preserves local single-bucket storage.
STORAGE_ASSETS_BUCKET=
STORAGE_CREATE_BUCKET_IF_MISSING=true
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=wiki-local
STORAGE_SECRET_KEY=wiki-local-storage
MEDIA_PUBLIC_BASE_URL=/media

# Optional read-model cache. Cache failures fall back to the database.
READ_MODEL_CACHE_ENABLED=true
READ_MODEL_CACHE_PREFIX=wiki:read-model:v1
READ_MODEL_CACHE_PUBLIC_TTL=2m
READ_MODEL_CACHE_ADMIN_TTL=30s
READ_MODEL_CACHE_RETRY_DELAY=5s
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# Defaults for new user profiles.
USER_DEFAULT_LOCALE=vi-VN
USER_DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh

