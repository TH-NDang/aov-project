# Merge these values into an ignored local environment file after migration verification.
STORAGE_ENDPOINT=https://a43cbaa6fb08a428abb4e76e06af0b97.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=aov-media-private
STORAGE_ASSETS_BUCKET=aov-media-assets
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=REPLACE_LOCALLY
STORAGE_SECRET_KEY=REPLACE_LOCALLY
STORAGE_CREATE_BUCKET_IF_MISSING=false
# The assets prefix is required: MediaUrls removes it from the stored object key.
# Production public image hostname; the private bucket has no public domain.
MEDIA_PUBLIC_BASE_URL=https://img.athahub.com/assets
# Isolate cached read models from local storage URLs during cutover.
READ_MODEL_CACHE_PREFIX=wiki:read-model:r2:v1
