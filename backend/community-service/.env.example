# Variables of community-service only; wiki-service has its own file (backend/wiki-service/.env.example).
# Copy to .env in this folder (git-ignored): scripts/dev/start-local.ps1 reads it. A variable already exported in the
# shell wins over the file. The values below are the local defaults of application.yml.
SERVER_PORT=8082
COMMUNITY_DATABASE_URL=jdbc:postgresql://localhost:5432/community
COMMUNITY_DATABASE_USER=community
COMMUNITY_DATABASE_PASSWORD=community-local
KEYCLOAK_ISSUER=http://localhost:8081/realms/wikiaov
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/wikiaov/protocol/openid-connect/certs
WIKI_BASE_URL=http://localhost:8080
COMMUNITY_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://127.0.0.1:5174,http://127.0.0.1:5175

# Daily exchange rates kept for prize amounts (ADR-020). Set to false to stop calling the source.
COMMUNITY_EXCHANGE_RATES_ENABLED=true
COMMUNITY_EXCHANGE_RATES_URL=https://api.frankfurter.dev

# YouTube Data API v3 key, created in the Google Cloud console and restricted to that API. Server-only: never put it in a
# frontend variable. Optional: without it the YouTube channel viewer reads the channel's public feed only.
YOUTUBE_API_KEY=
# Where the Data API and the channel feeds are read (ADR-034); change them only to point at a stand-in server.
COMMUNITY_YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
COMMUNITY_YOUTUBE_FEED_URL=https://www.youtube.com/feeds/videos.xml

# Claude API key that translates Stream posts (ADR-037), created in the Claude Console. Server-only: never put it in a
# frontend variable. Empty hides the Translate button.
ANTHROPIC_API_KEY=
# The model, new translations one account or address may start in an hour, and the most spent in a calendar month (UTC).
COMMUNITY_TRANSLATION_MODEL=claude-haiku-5-5
COMMUNITY_TRANSLATION_HOURLY=30
COMMUNITY_TRANSLATION_MONTHLY_BUDGET_USD=5
# Hosts post images are read from; others are left out of the translation.
COMMUNITY_TRANSLATION_IMAGE_HOSTS=img.athahub.com,localhost,127.0.0.1
