<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
<groupId>com.wikiaov</groupId><artifactId>community-service</artifactId><version>0.0.1-SNAPSHOT</version><name>Atha Community</name><description>Manual tournament research and public match records.</description>
<properties><java.version>21</java.version><community.build.directory>${project.basedir}/target</community.build.directory></properties>
<dependencies>
<dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-core</artifactId><version>2.1.1</version></dependency>
<dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-test</artifactId><version>2.1.1</version><scope>test</scope></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
