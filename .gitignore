# =====================================================================
# aov-project — root .gitignore (applies to the whole monorepo)
# Subdirectories may have their own .gitignore (e.g. backend/wiki-service).
# =====================================================================

# ---- resources/ IS committed: images go through Git LFS (see .gitattributes) ----

# ---- Secrets / local configuration ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ---- Java / Maven ----
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
HELP.md
hs_err_pid*.log
replay_pid*.log

# ---- Node / pnpm / Vite / Turborepo ----
node_modules/
dist/
dist-ssr/
.turbo/
.vite/
*.tsbuildinfo
coverage/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Python (scripts in resources) ----
__pycache__/
*.pyc

# ---- Log ----
logs/
*.log

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/

# ---- Operating system ----
.DS_Store
Thumbs.db
desktop.ini
